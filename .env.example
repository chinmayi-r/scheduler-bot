# Required
TELEGRAM_BOT_TOKEN=              # from @BotFather
TODOIST_API_TOKEN=               # Todoist Settings -> Integrations -> Developer -> API token
                                  # Todoist is the single source of truth for tasks -- the bot
                                  # only nudges/captures against it, it doesn't own a task table.

# Optional
DATABASE_URL=sqlite:///schedulerbot.db   # use a Railway volume path, or a Postgres URL, so data survives redeploys
DEFAULT_TIMEZONE=America/New_York        # only used before a user finishes onboarding
GCAL_ICS_URLS_JSON={"primary":"https://.../basic.ics"}  # optional bootstrap; can also be set per-user via chat
OPENAI_API_KEY=                  # enables voice-note capture (transcription needs OpenAI specifically)
OPENAI_TRANSCRIBE_MODEL=whisper-1
BOT_INSTANCE_LOCK=1              # prevents two pollers in the same container
ESCALATION_MAX=3                 # how many times to re-ping an ignored prompt
ESCALATION_MINUTES=10,30,60      # delay before each re-ping

# "Break it down" button. Any OpenAI-compatible endpoint; defaults to OpenRouter's
# free tier. Falls back to OPENAI_API_KEY if LLM_API_KEY isn't set.
LLM_API_KEY=                     # openrouter.ai/keys -- free tier is plenty here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pocket (heypocket.com) action-item sync. Setting the webhook secret turns on
# an HTTP listener at POST /webhooks/pocket.
POCKET_WEBHOOK_SECRET=           # the signing secret Pocket shows when you create the webhook
POCKET_API_KEY=                  # pk_... (optional, for pulling recordings directly)
POCKET_AUTO_CREATE=0             # 1 = add action items straight to Todoist instead of asking first
PORT=8080                        # Railway sets this automatically
